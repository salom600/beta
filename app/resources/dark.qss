/* Beta — Modern dark theme (QSS) */

* {
    font-family: "Segoe UI", "SF Pro Display", "Inter", "Noto Sans", sans-serif;
    font-size: 13px;
    color: #e6e6e8;
    outline: none;
}

QMainWindow, QWidget {
    background-color: #1e1f22;
}

QToolTip {
    background-color: #2d2e33;
    color: #f0f0f2;
    border: 1px solid #3c3d44;
    border-radius: 4px;
    padding: 4px 8px;
}

/* ---- Toolbar ---- */
QToolBar {
    background: #2a2b30;
    border: none;
    border-bottom: 1px solid #15161a;
    padding: 4px 8px;
    spacing: 4px;
}

QToolBar::separator {
    background: #3c3d44;
    width: 1px;
    height: 22px;
    margin: 0 6px;
}

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px 10px;
    color: #c8c9ce;
}

QToolButton:hover {
    background: #3a3b42;
    border-color: #4a4b54;
    color: #ffffff;
}

QToolButton:pressed,
QToolButton:checked {
    background: #0e63d4;
    border-color: #0e63d4;
    color: #ffffff;
}

QToolButton:disabled {
    color: #5a5b62;
}

/* ---- Buttons ---- */
QPushButton {
    background: #2d2e33;
    border: 1px solid #3c3d44;
    border-radius: 6px;
    padding: 6px 14px;
    color: #e6e6e8;
}

QPushButton:hover {
    background: #3a3b42;
    border-color: #4a4b54;
}

QPushButton:pressed {
    background: #0e63d4;
    border-color: #0e63d4;
}

QPushButton:disabled {
    color: #5a5b62;
    background: #232428;
}

QPushButton#primaryBtn {
    background: #0e63d4;
    border-color: #0e63d4;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#primaryBtn:hover {
    background: #1a78f0;
}

/* ---- Panels ---- */
QGroupBox {
    background: #232428;
    border: 1px solid #3c3d44;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 14px;
    font-weight: 600;
    color: #c8c9ce;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    left: 10px;
    background: #1e1f22;
}

/* ---- ListWidget (media browser) ---- */
QListWidget {
    background: #1e1f22;
    border: 1px solid #2a2b30;
    border-radius: 6px;
    padding: 4px;
    outline: 0;
}

QListWidget::item {
    background: transparent;
    border-radius: 4px;
    padding: 6px 8px;
    margin: 1px 0;
}

QListWidget::item:hover {
    background: #2a2b30;
}

QListWidget::item:selected {
    background: #0e63d4;
    color: #ffffff;
}

/* ---- Inputs ---- */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: #15161a;
    border: 1px solid #3c3d44;
    border-radius: 4px;
    padding: 4px 8px;
    selection-background-color: #0e63d4;
    selection-color: #ffffff;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #0e63d4;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background: #2a2b30;
    border: none;
    width: 16px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: #3a3b42;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background: #1e1f22;
    border: 1px solid #3c3d44;
    selection-background-color: #0e63d4;
    outline: 0;
}

/* ---- Slider ---- */
QSlider::groove:horizontal {
    background: #15161a;
    height: 4px;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #0e63d4;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    border: none;
    width: 12px;
    height: 12px;
    margin: -4px 0;
    border-radius: 6px;
}

QSlider::handle:horizontal:hover {
    background: #f0f0f2;
}

/* ---- Splitter ---- */
QSplitter::handle {
    background: #2a2b30;
}

QSplitter::handle:hover {
    background: #0e63d4;
}

QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical   { height: 2px; }

/* ---- Scrollbar ---- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #3a3b42;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #4a4b54;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #3a3b42;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #4a4b54;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---- Statusbar ---- */
QStatusBar {
    background: #2a2b30;
    border-top: 1px solid #15161a;
    color: #a0a1a6;
}

QStatusBar QLabel {
    padding: 2px 8px;
}

/* ---- Menu ---- */
QMenuBar {
    background: #2a2b30;
    border-bottom: 1px solid #15161a;
    padding: 2px 0;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background: #3a3b42;
}

QMenu {
    background: #2a2b30;
    border: 1px solid #3c3d44;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background: #0e63d4;
}

QMenu::separator {
    height: 1px;
    background: #3c3d44;
    margin: 4px 8px;
}

/* ---- Label ---- */
QLabel {
    background: transparent;
}

QLabel#titleLabel {
    font-size: 14px;
    font-weight: 600;
    color: #ffffff;
    padding: 4px 0;
}

QLabel#hintLabel {
    color: #7a7b82;
    font-size: 12px;
}

/* ---- Video preview frame ---- */
QVideoWidget {
    background: #000000;
    border-radius: 4px;
}

/* ---- QFrame panels ---- */
QFrame#panel {
    background: #232428;
    border-radius: 8px;
}
